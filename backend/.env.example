# ─────────────────────────────────────────────────────────────────────────────
# Midas Learning Cloud — API environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the SPA). No trailing slash.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Public base URL of this API, used to build absolute links in emails/exports.
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the SPA, used for invitation/recovery links.
WEB_PUBLIC_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────────
# MySQL 8.0+. Create the database and a dedicated user first:
#   CREATE DATABASE midas_learning_cloud CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'midas'@'localhost' IDENTIFIED BY 'change-me';
#   GRANT ALL PRIVILEGES ON midas_learning_cloud.* TO 'midas'@'localhost';
#   FLUSH PRIVILEGES;
DATABASE_URL="mysql://midas:change-me@localhost:3306/midas_learning_cloud?connection_limit=10&pool_timeout=20"

# ── Authentication ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-access
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-refresh
# Short-lived access token; refresh token is rotated and stored in the Session table.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie settings for the refresh token. Set COOKIE_SECURE=true behind HTTPS.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Argon2id password hashing cost. Raise memoryCost on a larger VPS.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Account protection
MAX_FAILED_LOGIN_ATTEMPTS=8
ACCOUNT_LOCK_MINUTES=15

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15

# ── File storage ────────────────────────────────────────────────────────────
# `local` writes to STORAGE_LOCAL_DIR. `s3` is a documented future extension
# (see src/core/storage/README.md) — the driver interface is already in place.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_PUBLIC_PATH=/media
MAX_UPLOAD_BYTES=10485760

# ── Platform bootstrap ──────────────────────────────────────────────────────
# Used once by `npm run db:seed` to create the first Platform Owner.
BOOTSTRAP_OWNER_EMAIL=owner@midasstudio.example
BOOTSTRAP_OWNER_PASSWORD=ChangeMe!2026
BOOTSTRAP_OWNER_NAME=Midas Platform Owner
# Set to `true` to also seed the demo pilot school with sample content/users.
SEED_DEMO_DATA=true

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# `pretty` requires pino-pretty (dev only); use `json` in production.
LOG_FORMAT=json
