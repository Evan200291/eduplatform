// ─────────────────────────────────────────────────────────────────────────────
// Academic structure — grades, terms, subjects, classes and memberships
// Blueprint 02: Platform → Organization → School → Grade → Class → User
// Blueprint 05: "Grade, class and subject structures are school-configurable."
// ─────────────────────────────────────────────────────────────────────────────

model Grade {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name           String   @db.VarChar(120)
  key            String   @db.VarChar(60)
  /// Ordinal used for progression logic (e.g. 3 for Year 3).
  level          Int
  /// Typical age at the start of this grade — feeds age-appropriate defaults.
  typicalAgeFrom Int?
  typicalAgeTo   Int?
  ageMode        AgeMode?
  sortOrder      Int      @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  classes            Class[]
  studentProfiles    StudentProfile[]
  roleAssignments    UserRoleAssignment[]
  entitlements       FeatureEntitlement[]
  curriculumPrograms CurriculumProgram[]
  topics             Topic[]

  @@unique([schoolId, key])
  @@index([schoolId, level])
  @@map("grades")
}

/// Optional term/semester calendar. Reports and assignments can be filtered by it.
model AcademicTerm {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String   @db.VarChar(120)
  startsAt  DateTime
  endsAt    DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes     Class[]
  assignments Assignment[]

  @@index([schoolId, isCurrent])
  @@map("academic_terms")
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(120)
  key         String  @db.VarChar(60)
  description String? @db.VarChar(500)
  colorHex    String? @db.VarChar(9)
  iconKey     String? @db.VarChar(60)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  curriculumPrograms CurriculumProgram[]
  units              Unit[]
  topics             Topic[]
  lessons            Lesson[]
  activities         Activity[]
  assessments        Assessment[]
  learningPaths      LearningPath[]
  recommendations    Recommendation[]
  masteryRecords     MasteryRecord[]
  teacherAssessments TeacherAssessment[]
  classTeachers      ClassTeacher[]
  classSubjects      ClassSubject[]
  roleAssignments    UserRoleAssignment[]
  entitlements       FeatureEntitlement[]
  assignments        Assignment[]

  @@unique([schoolId, key])
  @@index([schoolId])
  @@map("subjects")
}

model Class {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeId  String
  grade    Grade  @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)

  name        String  @db.VarChar(120)
  code        String  @db.VarChar(40)
  description String? @db.VarChar(500)
  capacity    Int?
  isActive    Boolean @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  memberships     ClassMembership[]
  teachers        ClassTeacher[]
  classSubjects   ClassSubject[]
  assignments     Assignment[]
  missions        Mission[]
  roleAssignments UserRoleAssignment[]
  entitlements    FeatureEntitlement[]

  @@unique([schoolId, code])
  @@index([schoolId, gradeId])
  @@map("classes")
}

/// Which subjects a class studies. Drives the subject cohort assignment target.
model ClassSubject {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  weeklyMinutes Int?
  createdAt     DateTime @default(now())

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@map("class_subjects")
}

model ClassMembership {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  isActive  Boolean   @default(true)
  addedById String?   @db.VarChar(32)

  @@unique([classId, userId])
  @@index([userId, isActive])
  @@map("class_memberships")
}

/// Blueprint 04: a teacher's visibility comes from their class assignments.
model ClassTeacher {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /// The lead teacher owns reporting and homework defaults for the class.
  isLead    Boolean  @default(false)

  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  @@unique([classId, userId, subjectId], map: "class_teacher_subject_unique")
  @@index([userId])
  @@map("class_teachers")
}
