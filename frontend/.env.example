# Midas Learning Cloud — Frontend environment
# Copy to `.env` (or `.env.local`) and adjust for your setup.

# Backend origin the Vite dev server proxies /api and /media to.
# Leave the app's runtime API base as a relative path so cookies stay same-origin.
VITE_DEV_API_TARGET=http://localhost:4000

# Runtime API base path. Keep relative in dev (proxied); set to an absolute
# origin only if the SPA is served from a different host than the API.
VITE_API_BASE_URL=/api/v1
